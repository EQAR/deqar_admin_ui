# Copy to .env.production and replace the example values before deploying.
# Runtime configuration: these values are not embedded in the image.
NEXTAUTH_URL=https://admin.example.org
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Container-reachable API root, including any path prefix; no trailing slash.
# localhost here would refer to the admin container, not the Docker host.
DJANGO_API_BASE=https://api.example.org

# Build configuration: public URL templates. Keep the literal {id} placeholder.
# Changing these requires rebuilding the image.
REACT_APP_WEBSITE_AGENCY=https://www.example.org/register/agencies/agency/?id={id}
REACT_APP_WEBSITE_COUNTRY=https://www.example.org/register/countries/country/?id={id}
REACT_APP_WEBSITE_INSTITUTION=https://www.example.org/qa-results/search/by-institution/institution/?id={id}
REACT_APP_WEBSITE_REPORT=https://www.example.org/qa-results/search/by-report/report/?id={id}
REACT_APP_ESCO_API=https://ec.europa.eu/esco/api/search

# Optional deployment settings.
ADMIN_PORT=3000
IMAGE_TAG=latest
